# Build environment for the AppImage's GUI. Ubuntu 20.04 has glibc 2.31, so the frozen GUI
# runs on any distro with glibc 2.31 or newer (SteamOS, Arch, Fedora, Debian 11+, Ubuntu 20.04+, ...).
# Used by appimage/build-in-container.sh.
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
	ca-certificates curl file binutils git \
	python3.9 python3.9-venv libpython3.9 \
	libfontconfig1 libfreetype6 libx11-6 libx11-xcb1 libxkbcommon0 libxkbcommon-x11-0 libdbus-1-3 \
	libxcb1 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 \
	libxcb-shape0 libxcb-xfixes0 libxcb-xinerama0 libxcb-xkb1 libxcb-sync1 libxcb-shm0 \
	libgl1 libegl1 libglib2.0-0 libwayland-client0 libwayland-cursor0 libwayland-egl1 \
	&& rm -rf /var/lib/apt/lists/*
# Qt's X11 plugin needs libxcb-cursor, which 20.04 doesn't package; take 22.04's (needs only glibc 2.14).
RUN curl -fsSL -o /tmp/xcb-cursor.deb \
		http://archive.ubuntu.com/ubuntu/pool/universe/x/xcb-util-cursor/libxcb-cursor0_0.1.1-4ubuntu1_amd64.deb \
	&& echo "c9b5d1ad4af57397b1bd77e0a92750e34419def134c0282a0836ae9efc07cf64  /tmp/xcb-cursor.deb" | sha256sum -c - \
	&& dpkg -i /tmp/xcb-cursor.deb && rm /tmp/xcb-cursor.deb

# PySide6 from PyPI: its Qt is built for glibc 2.28 and brings no distro/KDE plugins.
# 6.9 is the last series with Python 3.9 / glibc 2.28 wheels.
RUN python3.9 -m venv /opt/venv \
	&& /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
	&& /opt/venv/bin/pip install --no-cache-dir "PySide6-Essentials==6.9.*" pyinstaller
ENV PATH=/opt/venv/bin:$PATH
