@@ -0,0 +1,42 @@
+// Overstrike -- an open-source mod manager for PC ports of Insomniac Games' games.
+// This program is free software, and can be redistributed and/or modified by you. It is provided 'as-is', without any warranty.
+// For more details, terms and conditions, see GNU General Public License.
+// A copy of the that license should come with this program (LICENSE.txt). If not, see <http://www.gnu.org/licenses/>.
+
+using System;
+using System.IO;
+
+namespace DAT1 {
+	// Archive names inside 'toc' are Windows-style ("d\mods\mod0"). On Windows they can be
+	// passed to Path.Combine as-is, but on Linux '\' is a regular filename character and
+	// the filesystem is case-sensitive. This helper turns such a name into a real path.
+	public static class GamePaths {
+		public static string Resolve(string basePath, string tocRelativePath) {
+			if (Path.DirectorySeparatorChar == '\\') {
+				return Path.Combine(basePath, tocRelativePath);
+			}
+
+			var parts = tocRelativePath.Split(new[] { '\\', '/' }, StringSplitOptions.RemoveEmptyEntries);
+			var current = basePath;
+			for (var i = 0; i < parts.Length; ++i) {
+				var exact = Path.Combine(current, parts[i]);
+				if (File.Exists(exact) || Directory.Exists(exact) || !Directory.Exists(current)) {
+					current = exact;
+					continue;
+				}
+
+				// fall back to a case-insensitive match, like Windows would do
+				string match = null;
+				foreach (var entry in Directory.EnumerateFileSystemEntries(current)) {
+					if (Path.GetFileName(entry).Equals(parts[i], StringComparison.OrdinalIgnoreCase)) {
+						match = entry;
+						break;
+					}
+				}
+				current = match ?? exact;
+			}
+
+			return current;
+		}
+	}
+}
